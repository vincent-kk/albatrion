{
  "version": "3.0",
  "language": "ko",
  "ignore": [
    "**/legacy",
    "**/fixtures",
    "**/__fixtures__",
    "**/mock",
    "**/mocks",
    "**/__mocks__",
    "**/bench",
    "**/benchmarks",
    "**/__benchmarks__",
    "**/.storybook",
    "**/stories",
    "documents",
    "**/aileron/benchmark",
    "**/aileron/benchmark-form",
    "**/aileron/development-helper",
    "**/aileron/production-test",
    "**/eslint.config.js",
    "**/eslint.config.mjs",
    "**/benchmark",
    "**/packages/lerx/promise-modal/vitest.react18.config.ts",
    "**/packages/canard/schema-form/src/__tests__/e2e/exact-focus.production.test.ts"
  ],
  "adapters": {
    "mode": "auto",
    "enabled": [
      "ecmascript"
    ]
  },
  "rules": {
    "organ-no-intentmd": "error",
    "intent-document-contract": {
      "exempt": [
        "**/canard/schema-form-*-plugin/**"
      ]
    },
    "detail-document-contract": {
      "exempt": [
        "**/canard/schema-form-*-plugin/**"
      ]
    },
    "module-entry-point": {
      "exempt": [
        "**/canard/schema-form/src/app"
      ]
    },
    "zero-peer-file": {
      "exempt": [
        "**/aileron/schema-form-scenarios/src/**",
        "**/canard/schema-form-*-plugin/**",
        "**/lerx/promise-modal/**",
        "**/winglet/common-utils/**",
        "**/winglet/json/**",
        "**/winglet/react-utils/src/utils/filter",
        "**/winglet/react-utils/src/utils/object",
        "**/winglet/react-utils/src/utils/render",
        "**/winglet/react-utils/src/components/Portal",
        "**/winglet/react-utils/src/hoc/withErrorBoundary",
        "**/winglet/data-loader/src",
        "**/winglet/json-schema/src/filters",
        "**/winglet/json-schema/src/utils/JSONSchemaScanner/sync",
        "**/winglet/json-schema/src/utils/JSONSchemaScanner/async",
        "**/winglet/style-utils/src/styleManager",
        "**/winglet/style-utils/src/utils/cx"
      ]
    },
    "spec-document-case-cap": {
      "exempt": [
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/array.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/controls.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/derive.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/differential.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/exit.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/fill.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/notify.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/settle.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/union.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/validation.spec.ts",
        "**/packages/canard/schema-form/src/core/__tests__/scenarios/value.spec.ts"
      ]
    },
    "test-record-case-cap": {
      "exempt": [
        "**/packages/canard/schema-form-ajv6-plugin/src/__tests__/parity.guard.test.ts",
        "**/packages/canard/schema-form-ajv6-plugin/src/__tests__/parity.lifetime.test.ts",
        "**/packages/canard/schema-form-ajv6-plugin/src/__tests__/parity.validation.test.ts",
        "**/packages/canard/schema-form-ajv7-plugin/src/__tests__/parity.guard.dynamic.test.ts",
        "**/packages/canard/schema-form-ajv7-plugin/src/__tests__/parity.guard.test.ts",
        "**/packages/canard/schema-form-ajv7-plugin/src/__tests__/parity.lifetime.test.ts",
        "**/packages/canard/schema-form-ajv7-plugin/src/__tests__/parity.validation.test.ts",
        "**/packages/canard/schema-form-ajv8-plugin/src/__tests__/parity.guard.dynamic.test.ts",
        "**/packages/canard/schema-form-ajv8-plugin/src/__tests__/parity.guard.test.ts",
        "**/packages/canard/schema-form-ajv8-plugin/src/__tests__/parity.lifetime.test.ts",
        "**/packages/canard/schema-form-ajv8-plugin/src/__tests__/parity.validation.test.ts",
        "**/packages/canard/schema-form/src/__tests__/e2e/features-composite-shared-1.test.tsx",
        "**/packages/canard/schema-form/src/__tests__/e2e/features-composite-shared-2.test.tsx",
        "**/packages/canard/schema-form/src/__tests__/e2e/features-composite-tails.test.tsx",
        "**/packages/canard/schema-form/src/__tests__/e2e/features-input-components-consumer.test.tsx",
        "**/packages/canard/schema-form/src/__tests__/e2e/features-validation-state-display.test.tsx",
        "**/packages/canard/schema-form/src/__tests__/e2e/features-validation-state-timing.test.tsx",
        "**/packages/canard/schema-form/src/components/FieldProxy/components/FieldInputBridge/__tests__/refreshBoundary.test.tsx",
        "**/packages/canard/schema-form/src/components/FieldProxy/components/FieldInputBridge/__tests__/refreshGeneration.test.tsx",
        "**/packages/canard/schema-form/src/core/engine/settle/__tests__/settle.gate-wheel-differential.test.ts"
      ]
    },
    "circular-dependency": {
      "exempt": [
        "**/packages/canard/schema-form-mui-plugin/src",
        "**/packages/canard/schema-form-mui-plugin/src/fieldInputs",
        "**/packages/canard/schema-form/src/components/FieldProxy",
        "**/packages/canard/schema-form/src/components/FieldProxy/components/FieldInputBridge",
        "**/packages/winglet/common-utils/src/utils/object",
        "**/packages/winglet/common-utils/src/utils/object/merge",
        "**/packages/winglet/common-utils/src/utils/object/serialization",
        "**/packages/winglet/common-utils/src/utils/object/serialization/parseGraph",
        "**/packages/winglet/common-utils/src/utils/object/serialization/utils/encodeGraph"
      ]
    }
  },
  "structure": {
    "maxDepth": 14,
    "allowedPeers": [
      "type.ts",
      "style.ts",
      "constant.ts",
      "CLAUDE.md",
      "LICENSE",
      "README.md",
      "README-ko_kr.md",
      "eslint.config.js",
      "package.json",
      "rolldown.config.mjs",
      "vite.config.ts",
      "vitest.prod.config.ts",
      "tsconfig.json",
      "tsconfig.declarations.json",
      {
        "basename": "function.d.ts",
        "paths": [
          "**/packages/aileron/common/declare"
        ]
      },
      {
        "basename": "object.d.ts",
        "paths": [
          "**/packages/aileron/common/declare"
        ]
      },
      {
        "basename": "utility.d.ts",
        "paths": [
          "**/packages/aileron/common/declare"
        ]
      },
      {
        "basename": "unit.d.ts",
        "paths": [
          "**/packages/aileron/common/declare"
        ]
      }
    ],
    "organNames": [
      "fieldInputDefinitions"
    ],
    "entryPointOverrides": {
      "ecmascript": [
        "index.d.ts"
      ]
    }
  }
}
