{
  "name": "@canard/schema-form-ajv6-plugin",
  "version": "0.14.0",
  "description": "AJV 6.x validator plugin for @canard/schema-form providing JSON Schema validation with legacy Draft-04, Draft-06, and Draft-07 support",
  "keywords": [
    "react",
    "@canard/schema-form",
    "schema-form",
    "canard-form",
    "json-schema",
    "plugin",
    "validation",
    "validator",
    "ajv",
    "ajv6",
    "typescript",
    "form-validation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vincent-kk/albatrion.git",
    "directory": "packages/canard/schema-form-ajv6-plugin"
  },
  "license": "MIT",
  "author": {
    "name": "Vincent K. Kelvin",
    "email": "lunox273@gmail.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c && yarn build:types && yarn typecheck",
    "build:publish:npm": "yarn build && yarn publish:npm",
    "build:types": "node ../../aileron/script/build/buildTypes.mjs",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "publish:npm": "yarn npm publish --access public",
    "storybook": "storybook dev -p 6006",
    "test": "yarn run -T vitest",
    "typecheck": "tsc --noEmit --composite false --rootDir . -p tsconfig.json",
    "version:major": "yarn version major",
    "version:minor": "yarn version minor",
    "version:patch": "yarn version patch"
  },
  "dependencies": {
    "ajv": "^6.0.0"
  },
  "devDependencies": {
    "@canard/schema-form": "workspace:^",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "8.57.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rolldown": "^1.2.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.2"
  }
}
