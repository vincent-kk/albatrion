-          : input.schemaPath;
-      const gates = input.gates.map(
-        (gate) =>
-          `${gate.kind}:${gate.schemaPath}:${Boolean(gate.negated)}:${
-            gate.appliesWhen
-              ?.map((owner) => owner.schemaPath)
-              .filter((path, index, paths) => paths.indexOf(path) === index)
-              .join(',') ?? ''
