--- /dev/null
+++ b/packages/canard/schema-form/src/core/__tests__/SchemaNode.update-value-marking.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest';
+
+import { nodeFromJSONSchema } from '../nodeFromJSONSchema';
+import { markSchemaNodeEvent, SchemaNodeEventType } from '../record';
+
+describe('UpdateValue pending delivery', () => {
+  it('retains runtime membership, other bits and the last defined payload/options', () => {
+    const root = nodeFromJSONSchema({ jsonSchema: { type: 'string' }, validationMode: 0 });
+    Reflect.set(root, 'pendingDelivery', undefined);
+    root.runtime.deliveries?.clear();
+    root.pendingRevision = 0;
+    root.runtime.revisionNodes?.clear();
+    markSchemaNodeEvent(root, SchemaNodeEventType.RequestFocus);
+    const event = root.pendingDelivery;
+    const payload = { previous: 'before', current: 'after' }, options = { source: 'input' };
+    markSchemaNodeEvent(root, SchemaNodeEventType.UpdateValue, payload, options);
+    markSchemaNodeEvent(root, SchemaNodeEventType.UpdateValue);
+    expect(root.pendingDelivery).toBe(event);
+    expect(event?.type).toBe(SchemaNodeEventType.RequestFocus | SchemaNodeEventType.UpdateValue);
+    expect(event?.payload?.[SchemaNodeEventType.UpdateValue]).toBe(payload);
+    expect(event?.options?.[SchemaNodeEventType.UpdateValue]).toBe(options);
+    expect(Object.keys(event?.payload ?? {})).toEqual(['4']);
+    expect(Object.keys(event?.options ?? {})).toEqual(['4']);
+    expect(root.pendingRevision).toBe(SchemaNodeEventType.RequestFocus | SchemaNodeEventType.UpdateValue);
+    expect(root.runtime.deliveries?.has(root)).toBe(true);
+    expect(root.runtime.revisionNodes?.has(root)).toBe(true);
+  });
+
+  it('creates fresh pending tables after a delivery has been handed out', () => {
+    const root = nodeFromJSONSchema({ jsonSchema: { type: 'string' }, validationMode: 0 });
+    Reflect.set(root, 'pendingDelivery', undefined);
+    const first = { previous: 'zero', current: 'one' };
+    markSchemaNodeEvent(root, SchemaNodeEventType.UpdateValue, first, { source: 'input' });
+    const handed = root.pendingDelivery;
+    Reflect.set(root, 'pendingDelivery', undefined);
+    markSchemaNodeEvent(root, SchemaNodeEventType.UpdateValue, { previous: 'one', current: 'two' }, { source: 'automatic' });
+    expect(root.pendingDelivery).not.toBe(handed);
+    expect(root.pendingDelivery?.payload).not.toBe(handed?.payload);
+    expect(root.pendingDelivery?.options).not.toBe(handed?.options);
+    expect(handed?.payload?.[SchemaNodeEventType.UpdateValue]).toBe(first);
+    expect(handed?.options?.[SchemaNodeEventType.UpdateValue]).toEqual({ source: 'input' });
+  });
+
+  it('keeps delivered subscriber payloads and revisions unchanged on later writes', async () => {
+    const root = nodeFromJSONSchema({ jsonSchema: { type: 'string' }, defaultValue: 'zero', validationMode: 0 });
+    await Promise.resolve();
+    const events: { type: number; payload?: Partial<Record<SchemaNodeEventType, unknown>> }[] = [];
+    root.subscribe(event => events.push(event));
+    root.setValue('one');
+    const revision = root.revision(SchemaNodeEventType.UpdateValue);
+    root.setValue('two');
+    expect(events).toHaveLength(2);
+    expect(events[0].payload?.[SchemaNodeEventType.UpdateValue]).toEqual({ previous: 'zero', current: 'one' });
+    expect(events[1].payload?.[SchemaNodeEventType.UpdateValue]).toEqual({ previous: 'one', current: 'two' });
+    expect(events[1].payload).not.toBe(events[0].payload);
+    expect(root.revision(SchemaNodeEventType.UpdateValue)).toBe(revision + 1);
+  });
+});
