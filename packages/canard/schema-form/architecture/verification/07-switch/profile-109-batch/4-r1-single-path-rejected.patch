--- /dev/null
+++ b/packages/canard/schema-form/src/core/settle/__tests__/settle.recalculation-work.test.ts
@@ -0,0 +1,87 @@
+import { afterEach, expect, it, vi } from 'vitest';
+
+import { SetValueOption } from '../../types/value';
+import { loadSchemaNodeAtMount } from '../index';
+import { createSettlementContext } from '../utils/settlement/createSettlementContext';
+import { finishSettlement } from '../utils/settlement/finishSettlement';
+import { getSettlementScratch } from '../utils/write/getSettlementScratch';
+import { releaseSettlementScratch } from '../utils/write/releaseSettlementScratch';
+import { markWrite } from '../utils/write/markWrite';
+import { registerRecalculation } from '../utils/write/registerRecalculation';
+import * as dependencies from '../utils/write/getDependencyIndex';
+import { computeNode } from '../utils/compute/computeNode';
+import { createTestTree } from './fixtures/createTestTree';
+
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals(); });
+
+it('keeps dependency expansion and ancestor order without allocating a duplicate expansion Set', () => {
+  const { root } = createTestTree({ type: 'object', properties: {
+    group: { type: 'object', properties: { value: { type: 'string' } } },
+  } });
+  loadSchemaNodeAtMount(root, { group: { value: 'before' } }, SetValueOption.Overwrite);
+  const leaf = root.structure!.group.structure!.value;
+  const scratch = getSettlementScratch(root.runtime);
+  const context = createSettlementContext(leaf, 'input', SetValueOption.Overwrite, scratch);
+  markWrite(leaf, 'after', context);
+  const query = vi.spyOn(dependencies, 'getDependencyIndex');
+  const NativeSet = globalThis.Set;
+  let allocated = 0;
+  class CountedSet<T> extends NativeSet<T> {
+    constructor(values?: Iterable<T> | null) { super(values); allocated++; }
+  }
+  vi.stubGlobal('Set', CountedSet);
+  try { registerRecalculation(context); } finally { vi.unstubAllGlobals(); }
+  expect(allocated).toBe(1);
+  expect(query).toHaveBeenCalledTimes(1);
+  expect([...context.dirtyPaths]).toEqual(['/group/value', '/group', '']);
+  expect([...context.dirtyChildrenByParent!.get('/group')!]).toEqual([['/group/value', 'value']]);
+  expect([...context.dirtyChildrenByParent!.get('')!]).toEqual([['/group', 'group']]);
+  computeNode(root, context);
+  finishSettlement(context, scratch);
+  releaseSettlementScratch(scratch);
+  expect(root.emit).toEqual({ group: { value: 'after' } });
+  expect(root.runtime.commitNumber).toBe(2);
+});
+
+it('retains the general expansion and first-descendant order for multiple dirty paths', () => {
+  const { root } = createTestTree({ type: 'object', properties: {
+    left: { type: 'string' }, right: { type: 'string' },
+  } });
+  loadSchemaNodeAtMount(root, { left: 'L', right: 'R' }, SetValueOption.Overwrite);
+  const scratch = getSettlementScratch(root.runtime);
+  const context = createSettlementContext(root.structure!.left, 'input', SetValueOption.Overwrite, scratch);
+  markWrite(root.structure!.left, 'L2', context);
+  markWrite(root.structure!.right, 'R2', context);
+  registerRecalculation(context);
+  expect([...context.dirtyPaths]).toEqual(['/left', '/right', '']);
+  expect([...context.dirtyChildrenByParent!.get('')!]).toEqual([['/left', 'left'], ['/right', 'right']]);
+  computeNode(root, context);
+  finishSettlement(context, scratch);
+  releaseSettlementScratch(scratch);
+  expect(root.emit).toEqual({ left: 'L2', right: 'R2' });
+});
+
+it('keeps the general expansion when a dependency adds another declaration path', () => {
+  const { root } = createTestTree({ type: 'object', properties: {
+    source: { type: 'string' }, dependent: { type: 'string', controls: { watch: ['../source'] } },
+  } });
+  loadSchemaNodeAtMount(root, { source: 'before', dependent: 'D' }, SetValueOption.Overwrite);
+  dependencies.getDependencyIndex(root.runtime.blueprint);
+  const scratch = getSettlementScratch(root.runtime);
+  const context = createSettlementContext(root.structure!.source, 'input', SetValueOption.Overwrite, scratch);
+  markWrite(root.structure!.source, 'after', context);
+  const NativeSet = globalThis.Set;
+  let allocated = 0;
+  class CountedSet<T> extends NativeSet<T> {
+    constructor(values?: Iterable<T> | null) { super(values); allocated++; }
+  }
+  vi.stubGlobal('Set', CountedSet);
+  try { registerRecalculation(context); } finally { vi.unstubAllGlobals(); }
+  expect(allocated).toBe(3);
+  expect([...context.dirtyPaths]).toEqual(['/source', '', '/dependent']);
+  expect([...context.dependencyOwnerPaths]).toEqual(['/dependent']);
+  computeNode(root, context);
+  finishSettlement(context, scratch);
+  releaseSettlementScratch(scratch);
+  expect(root.emit).toEqual({ source: 'after', dependent: 'D' });
+});
