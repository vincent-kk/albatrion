--- /dev/null
+++ b/packages/canard/schema-form/src/core/settle/__tests__/settle.scratch-release-work.test.ts
@@ -0,0 +1,55 @@
+import { afterEach, expect, it, vi } from 'vitest';
+
+import { getSettlementScratch } from '../utils/write/getSettlementScratch';
+import { DirtyPathSet } from '../utils/write/DirtyPathSet';
+import { releaseSettlementScratch } from '../utils/write/releaseSettlementScratch';
+import { createTestTree } from './fixtures/createTestTree';
+
+afterEach(() => vi.restoreAllMocks());
+
+it('skips empty native clears while resetting the consumed post-order traversal for reuse', () => {
+  const { root } = createTestTree({ type: 'object', properties: { value: { type: 'string' } } });
+  const scratch = getSettlementScratch(root.runtime);
+  if (!(scratch.dirtyPaths instanceof DirtyPathSet)) throw new Error('Expected indexed scratch');
+  scratch.dirtyPaths.add('/branch/value');
+  scratch.dirtyPaths.beginPostOrder();
+  for (const path of ['/branch/value', '/branch', '']) scratch.dirtyPaths.delete(path);
+  expect(scratch.dirtyPaths.size).toBe(0);
+  expect(scratch.dirtyChildrenByParent.size).toBe(0);
+  const clearSet = vi.spyOn(Set.prototype, 'clear');
+  const clearMap = vi.spyOn(Map.prototype, 'clear');
+  releaseSettlementScratch(scratch);
+  expect(clearSet.mock.contexts.filter(value => value === scratch.dirtyPaths)).toHaveLength(0);
+  expect(clearMap.mock.contexts.filter(value => value === scratch.dirtyChildrenByParent)).toHaveLength(0);
+  expect(scratch.inUse).toBe(false);
+  expect(getSettlementScratch(root.runtime)).toBe(scratch);
+  scratch.dirtyPaths.add('/other/value');
+  expect([...scratch.dirtyPaths]).toEqual(['/other/value']);
+  releaseSettlementScratch(scratch);
+});
+
+it('clears every populated container and isolates a nested reservation', () => {
+  const { root } = createTestTree({ type: 'object', properties: { value: { type: 'string' } } });
+  const scratch = getSettlementScratch(root.runtime);
+  scratch.entered.add(root);
+  scratch.writtenInputs.set(root, 'before');
+  scratch.changedRaw.add('/value');
+  scratch.dirtyPaths.add('/value');
+  const nested = getSettlementScratch(root.runtime);
+  expect(nested).not.toBe(scratch);
+  nested.dirtyPaths.add('/nested');
+  const clearSet = vi.spyOn(Set.prototype, 'clear');
+  const clearMap = vi.spyOn(Map.prototype, 'clear');
+  releaseSettlementScratch(scratch);
+  expect(clearSet.mock.contexts.filter(value => value === scratch.dirtyPaths)).toHaveLength(1);
+  expect(clearMap.mock.contexts.filter(value => value === scratch.dirtyChildrenByParent)).toHaveLength(1);
+  expect(scratch.entered.size).toBe(0);
+  expect(scratch.writtenInputs.size).toBe(0);
+  expect(scratch.changedRaw.size).toBe(0);
+  expect(scratch.dirtyPaths.size).toBe(0);
+  expect(scratch.dirtyChildrenByParent.size).toBe(0);
+  expect(scratch.inUse).toBe(false);
+  expect([...nested.dirtyPaths]).toEqual(['/nested']);
+  expect(nested.inUse).toBe(true);
+  releaseSettlementScratch(nested);
+});
