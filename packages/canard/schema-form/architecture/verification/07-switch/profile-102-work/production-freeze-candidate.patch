+import type { BlueprintGate } from '../../../type';
+import { freezeBlueprintValue } from './freezeBlueprintValue';
+import { FrozenBlueprintValues } from './FrozenBlueprintValues';
+
+/**
+ * Complete shared gate metadata without entering its authored condition graph.
+ * @param gate - Producer-owned gate with generated evaluation reads.
+ * @returns Nothing; freezes only the gate and its generated discriminator metadata.
+ */
+export const freezeBlueprintGate = (gate: BlueprintGate): void => {
+  if (FrozenBlueprintValues.has(gate)) return;
+  freezeBlueprintValue(gate.evaluationReads);
+  if (gate.kind === 'discriminator') {
+    const condition = gate.condition as { values: readonly unknown[] };
+    freezeBlueprintValue(condition.values);
+    freezeBlueprintValue(condition);
+  }
+  freezeBlueprintValue(gate);
+};
