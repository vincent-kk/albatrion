+++ b/packages/canard/schema-form/src/core/blueprint/utils/freezeBlueprintValues/freezeBlueprintValues.ts
@@ -0,0 +1,72 @@
+import { isArray } from '@winglet/common-utils/filter';
+
+import type { Blueprint } from '../../type';
+import type { AnalysisContext } from '../analyze/type';
+import { DEFAULT_NO_ACTIVE } from '../effectiveSchema/utils/constant';
+import { freezeEffectiveSchema } from '../effectiveSchema/utils/freezeEffectiveSchema';
+import { freezeBlueprintDeclarations } from './utils/freezeBlueprintDeclarations';
+import { freezeBlueprintGate } from './utils/freezeBlueprintGate';
+import { freezeBlueprintValue } from './utils/freezeBlueprintValue';
+
+/** Module-time environment selection is identical to the commit delivery mechanism. */
+const DEVELOPMENT = process.env.NODE_ENV !== 'production';
+
+/**
+ * Publish all completed analysis records with shallow, ownership-specific protection.
+ * @param context - Finished invocation graph; transient schema folds are not retained targets.
+ * @param result - Stable blueprint assembled from this context without copying fields.
+ * @returns Nothing; preserves every reference and never traverses authored values.
+ */
+export const freezeBlueprintValues = (context: AnalysisContext, result: Blueprint): void => {
+  for (let index = 0; index < context.fragments.length; index++) {
+    const fragment = context.fragments[index];
+    freezeBlueprintValue(fragment.order);
+    freezeBlueprintValue(fragment.gates);
+    for (let gate = 0; gate < fragment.gates.length; gate++)
+      freezeBlueprintGate(fragment.gates[gate]);
+    if (DEVELOPMENT) {
+      freezeBlueprintValue(fragment.declares);
+      freezeBlueprintValue(fragment.overlays);
+      freezeBlueprintValue(fragment.inheritedOverlays);
+      freezeBlueprintValue(fragment.children);
+      freezeBlueprintValue(fragment);
+    }
+  }
+  for (let index = 0; index < context.nodes.length; index++) {
+    const node = context.nodes[index];
+    if (isArray(node.schemaType)) freezeBlueprintValue(node.schemaType);
+    const effective = DEFAULT_NO_ACTIVE.get(node);
+    if (effective) freezeEffectiveSchema(effective);
+    freezeBlueprintDeclarations(node.declarations);
+    if (node.kind === 'virtual') freezeBlueprintValue(node.declarations);
+    const entries = node.childEntries;
+    for (let entry = 0; entry < entries.length; entry++) {
+      const child = entries[entry];
+      freezeBlueprintDeclarations(child.declarations);
+      if (DEVELOPMENT || node.kind === 'virtual') freezeBlueprintValue(child);
+    }
+    if (DEVELOPMENT) {
+      if (node.fields) freezeBlueprintValue(node.fields);
+      if (node.prefixItems) freezeBlueprintValue(node.prefixItems);
+      freezeBlueprintValue(entries);
+      freezeBlueprintValue(node);
+    }
+  }
+  if (DEVELOPMENT) {
+    for (let index = 0; index < context.declarations.length; index++)
+      freezeBlueprintValue(context.declarations[index]);
+    for (let index = 0; index < result.expressions.length; index++) {
+      const expression = result.expressions[index];
+      freezeBlueprintValue(expression.dependencies);
+      freezeBlueprintValue(expression);
+    }
+    const ids = Object.values(result.dependencies);
+    for (let index = 0; index < ids.length; index++) freezeBlueprintValue(ids[index]);
+    freezeBlueprintValue(result.expressions);
+    freezeBlueprintValue(result.dependencies);
+    freezeBlueprintValue(context.capabilities);
+    freezeBlueprintValue(context.nodes);
+    freezeBlueprintValue(context.fragments);
+    freezeBlueprintValue(result);
+  }
+};
