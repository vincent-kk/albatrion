+import { Suspense, createElement, createRef, lazy, useState } from 'react';
+import { flushSync } from 'react-dom';
+import { createRoot } from 'react-dom/client';
+import { describe, expect, it } from 'vitest';
+
+import { Form, type FormHandle, type FormTypeInputProps, type FormTypeRendererProps, type JSONSchema } from '@/schema-form';
+import { schemaNodeFactory, mountSchemaNode } from '@/schema-form/core';
+import { blueprint, getItemEntry } from '@/schema-form/core/blueprint';
+import type { BlueprintNode } from '@/schema-form/core/blueprint';
+
+const DEVELOPMENT = process.env.NODE_ENV !== 'production';
+/** Render the authored label through the public renderer-props contract. */
+const Label = ({ label }: FormTypeRendererProps) => <>{label}</>;
+
+describe('102C-01 consumer render values', () => {
+  it('renders an inline lazy input without freezing its mutable React payload', async () => {
+    expect('_store' in createElement('span')).toBe(DEVELOPMENT);
+    const Input = lazy(async () => ({ default: ({ value }: FormTypeInputProps) =>
+      <input data-lazy value={value ?? ''} readOnly /> }));
+    const schema: JSONSchema = { type: 'string', presentation: { FormTypeInput: Input } };
+    const container = document.createElement('div');
+    document.body.append(container);
+    const root = createRoot(container);
+    try {
+      flushSync(() => root.render(<Suspense fallback={<span>loading</span>}>
+        <Form jsonSchema={schema} defaultValue="loaded" />
+      </Suspense>));
+      for (let index = 0; index < 60 && !container.querySelector('[data-lazy]'); index++)
+        await new Promise(resolve => setTimeout(resolve, 10));
+      expect(container.querySelector<HTMLInputElement>('[data-lazy]')?.value).toBe('loaded');
+      expect(Object.isFrozen(Input)).toBe(false);
+      expect(Object.isFrozen((Input as unknown as { _payload: object })._payload)).toBe(false);
+    } finally { flushSync(() => root.unmount()); container.remove(); }
+  });
+
+  it('renders a JSX label created during render and supports a later React update', async () => {
+    let update: ((value: number) => void) | undefined;
+    const labels: unknown[] = [];
+    const Consumer = () => {
+      const [value, setValue] = useState(0);
+      update = setValue;
+      const label = <span data-label>label-{value}</span>;
+      labels.push(label);
+      return <Form key={value} FormTypeLabelRenderer={Label} jsonSchema={{ type: 'string', presentation: { FormTypeRendererProps: { label } } }}>
+        <Form.Label path="" /><Form.Input path="" />
+      </Form>;
+    };
+    const container = document.createElement('div');
+    document.body.append(container);
+    const root = createRoot(container);
+    try {
+      flushSync(() => root.render(<Consumer />));
+      expect(container.querySelector('[data-label]')?.textContent).toBe('label-0');
+      flushSync(() => update!(1));
+      await new Promise(resolve => setTimeout(resolve, 0));
+      expect(container.querySelector('[data-label]')?.textContent).toBe('label-1');
+      for (const label of labels) {
+        const element = label as { _store?: object };
+        if (element._store) expect(Object.isFrozen(element._store)).toBe(false);
+      }
+    } finally { flushSync(() => root.unmount()); container.remove(); }
+  });
+
+  it('creates a new array slot after mount and reuses its completed entry', async () => {
+    const schema: JSONSchema = { type: 'array', items: { type: 'string' } };
+    const first = createRef<FormHandle>(), second = createRef<FormHandle>();
+    const container = document.createElement('div');
+    document.body.append(container);
+    const root = createRoot(container);
+    try {
+      flushSync(() => root.render(<><Form ref={first} jsonSchema={schema} defaultValue={[]} />
+        <Form ref={second} jsonSchema={schema} defaultValue={[]} /></>));
+      first.current!.setValue(['new']);
+      await new Promise(resolve => setTimeout(resolve, 0));
+      const node = first.current!.findNode('')!;
+      const template = (node as unknown as { blueprintNode: BlueprintNode }).blueprintNode;
+      const entry = getItemEntry(template, 0)!;
+      expect(first.current!.getValue()).toEqual(['new']);
+      expect(Object.isFrozen(entry)).toBe(DEVELOPMENT);
+      expect(Object.isFrozen(entry.declarations)).toBe(DEVELOPMENT);
+      expect(Object.isFrozen(entry.declarations[0])).toBe(DEVELOPMENT);
+      expect(Object.isFrozen(entry.declarations[0].order)).toBe(true);
+      expect(Object.isFrozen(entry.declarations[0].gates)).toBe(true);
+      second.current!.setValue(['other']);
+      await new Promise(resolve => setTimeout(resolve, 0));
+      const other = second.current!.findNode('')!;
+      const otherTemplate = (other as unknown as { blueprintNode: BlueprintNode }).blueprintNode;
+      const otherEntry = getItemEntry(otherTemplate, 0)!;
+      expect(Object.isFrozen(otherEntry)).toBe(DEVELOPMENT);
+      expect(getItemEntry(otherTemplate, 0)).toBe(otherEntry);
+      expect(getItemEntry(template, 0)).toBe(entry);
+    } finally { flushSync(() => root.unmount()); container.remove(); }
+  });
+
+  it('reuses a post-mount slot when two mounted hosts share the same blueprint', () => {
+    const graph = blueprint({ type: 'array', items: { type: 'string' } });
+    const first = schemaNodeFactory(graph, { loadSnapshot: [], diagnostics: { status: 'stable' } });
+    const second = schemaNodeFactory(graph, { loadSnapshot: [], diagnostics: { status: 'stable' } });
+    mountSchemaNode(first);
+    mountSchemaNode(second);
+    first.setValue(['first']);
+    const entry = getItemEntry(graph.root, 0)!;
+    second.setValue(['second']);
+    expect(getItemEntry((second as unknown as { blueprintNode: BlueprintNode }).blueprintNode, 0)).toBe(entry);
+    expect(Object.isFrozen(entry)).toBe(DEVELOPMENT);
+    expect(first.value).toEqual(['first']);
+    expect(second.value).toEqual(['second']);
+  });
+});
