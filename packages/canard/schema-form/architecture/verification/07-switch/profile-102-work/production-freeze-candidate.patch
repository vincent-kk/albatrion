+import { FrozenBlueprintValues } from './FrozenBlueprintValues';
+
+/**
+ * Shallowly freeze one producer-owned value once across all completed aliases.
+ * @param value - A new analysis value, never an authored consumer object.
+ * @returns The identical value with its own properties protected.
+ */
+export const freezeBlueprintValue = <Value extends object>(value: Value): Value => {
+  if (!FrozenBlueprintValues.has(value)) {
+    FrozenBlueprintValues.add(value);
+    Object.freeze(value);
+  }
+  return value;
+};
