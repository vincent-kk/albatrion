+import { freezeBlueprintValue } from '../../freezeBlueprintValues/utils/freezeBlueprintValue';
+import { OwnedSchemaValues } from './OwnedSchemaValues';
+
+/** Bundlers replace this module-time predicate, matching commit payload protection. */
+const DEVELOPMENT = process.env.NODE_ENV !== 'production';
+/** The public container vocabulary is fixed; authored graphs are never traversed. */
+const OWNED_KEYS = ['required', 'allOf', 'enum', 'controls', 'options', 'presentation', 'type'];
+
+/**
+ * Complete a retained static or newly created runtime result without deep freezing.
+ * @param result - Finished result whose producer has registered its new containers.
+ * @returns The identical result, with public owned values protected in either mode.
+ */
+export const freezeEffectiveSchema = (result: EffectiveSchema): EffectiveSchema => {
+  const schema = result.schema;
+  if (typeof schema === 'object') {
+    for (let index = 0; index < OWNED_KEYS.length; index++) {
+      const value = schema[OWNED_KEYS[index]];
+      if (value && typeof value === 'object' && OwnedSchemaValues.has(value))
+        freezeBlueprintValue(value);
+    }
+    const clauses = schema.allOf;
+    if (isArray(clauses))
+      for (let index = 0; index < clauses.length; index++) {
+        const clause = clauses[index];
+        if (clause && typeof clause === 'object' && OwnedSchemaValues.has(clause))
+          freezeBlueprintValue(clause);
+      }
+    freezeBlueprintValue(schema);
+  }
+  if (DEVELOPMENT) freezeBlueprintValue(result);
+  return result;
+};
