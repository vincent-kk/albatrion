+import type { PropertyDeclaration } from '../../../type';
+import { freezeBlueprintGate } from './freezeBlueprintGate';
+import { freezeBlueprintValue } from './freezeBlueprintValue';
+
+/** Bundlers remove owned-record protection only for the production build. */
+const DEVELOPMENT = process.env.NODE_ENV !== 'production';
+
+/**
+ * Finish one owned declaration list while retaining shared gate protections.
+ * @param declarations - Node-owned or binding-owned records with authored schema references.
+ * @returns Nothing; never freezes schemas, conditions or other authored children.
+ */
+export const freezeBlueprintDeclarations = (declarations: readonly PropertyDeclaration[]): void => {
+  for (let index = 0; index < declarations.length; index++) {
+    const declaration = declarations[index];
+    const gates = declaration.gates;
+    for (let gate = 0; gate < gates.length; gate++) freezeBlueprintGate(gates[gate]);
+    if (DEVELOPMENT) {
+      freezeBlueprintValue(gates);
+      freezeBlueprintValue(declaration);
+    }
+  }
+  if (DEVELOPMENT) freezeBlueprintValue(declarations);
+};
diff --git a/packages/canard/schema-form/src/core/blueprint/utils/freezeBlueprintValues/freezeBlueprintValues.ts b/packages/canard/schema-form/src/core/blueprint/utils/freezeBlueprintValues/freezeBlueprintValues.ts
