--- /dev/null
+++ b/packages/canard/schema-form/src/core/settle/utils/gates/getGateResultMemo.ts
@@ -0,0 +1,218 @@
+import { hasOwnProperty } from '@winglet/common-utils/lib';
+import { unescapeSegment } from '@winglet/json/pointer';
+
+import type { Blueprint } from '../../../blueprint';
+import type { SchemaNodeRecord } from '../../../record';
+import type { SettlementContext } from '../../type';
+import { flushPendingOutput } from '../compute/flushPendingOutput';
+import { getGateExpression } from './getGateExpression';
+import { readProjectedValue } from './readProjectedValue';
+import type { GateOccurrence } from './type';
+import type { GateResultPlan, GateResultSlot, GateResultWork } from './getGateResultMemo/type';
+import { readPureGateKey } from './getGateResultMemo/utils/readPureGateKey';
+import { evaluatePureGate } from './getGateResultMemo/utils/evaluatePureGate';
+import { readGateResultShadow } from './getGateResultMemo/utils/readGateResultShadow';
+import { hasPureGateCandidates } from './getGateResultMemo/utils/hasPureGateCandidates';
+
+/** Root hosts need no decoded path allocation. */
+const ROOT_SEGMENTS: readonly string[] = Object.freeze([]);
+
+/** Runtime-owned provisional and committed pure function results. */
+class GateResultMemo {
+  /** Eligibility is tied to the real registry occurrence's lifetime. */
+  private readonly plans: WeakMap<GateOccurrence, GateResultPlan | null> | undefined;
+  /** A failed commit discards committed proofs without visiting other occurrences. */
+  private committed: WeakMap<GateOccurrence, GateResultSlot> | undefined;
+  /** Settlement work is weakly held and explicitly released on commit. */
+  private readonly works: WeakMap<object, GateResultWork> | undefined;
+
+  /**
+   * Bind an immutable analysis without running any gate.
+   * @param blueprint - Compiler descriptors, or absence for the shared empty memo
+   */
+  constructor(private readonly blueprint?: Blueprint) {
+    this.plans = blueprint ? new WeakMap() : undefined;
+    this.committed = blueprint ? new WeakMap() : undefined;
+    this.works = blueprint ? new WeakMap() : undefined;
+  }
+
+  /**
+   * Invalidate provisional proofs after marking, including rollback and rekey.
+   * @param context - Marked call whose existing work crosses a write boundary
+   * @returns Nothing; current-read comparisons remain mandatory
+   */
+  touch<Self extends SchemaNodeRecord<Self>>(context: SettlementContext<Self>): void {
+    const work = this.works?.get(context);
+    if (work) work.version++;
+  }
+
+  /**
+   * Verify current host ancestors once on entry to each original wheel pass.
+   * @param node - Host about to evaluate its original ordered gate set
+   * @param context - Call with current marked inputs and structure
+   * @returns Nothing; unsafe ancestors force baseline reads for this pass
+   */
+  beginPass<Self extends SchemaNodeRecord<Self>>(node: Self,
+    context: SettlementContext<Self>): void {
+    if (!this.blueprint) return;
+    const work = this.work(context);
+    let safe = true;
+    let touched = false;
+    for (let ancestor: Self | null = node; ancestor; ancestor = ancestor.parent) {
+      if (ancestor.behavior.strategy === 'branch' && ancestor.raw !== undefined)
+        safe = false;
+      if (context.changedRaw.has(ancestor.path)) touched = true;
+    }
+    work.passes.set(node, { safe, touched, version: work.version });
+  }
+
+  /**
+   * Evaluate or reuse one success only after the original-site read proof.
+   * @param occurrence - Actual locate result, including edge and appearance binding
+   * @param context - Original-site projection, pending publication and marked paths
+   * @returns Successful boolean, or undefined to retain the full evaluator
+   */
+  evaluate<Self extends SchemaNodeRecord<Self>>(
+    occurrence: GateOccurrence, context: SettlementContext<Self>,
+  ): boolean | undefined {
+    if (!this.blueprint) return;
+    let plan = this.plans!.get(occurrence);
+    if (plan === null) return;
+    let segments = plan?.segments ?? ROOT_SEGMENTS;
+    if (!plan && occurrence.hostPath) {
+      const decoded = occurrence.hostPath.slice(1).split('/');
+      for (let index = 0; index < decoded.length; index++)
+        decoded[index] = unescapeSegment(decoded[index]);
+      segments = decoded;
+    }
+    let host: Self | undefined = context.root;
+    for (let index = 0; index < segments.length; index++) {
+      const structure: Record<string, Self> | null | undefined = host?.structure;
+      host = structure && hasOwnProperty(structure, segments[index])
+        ? structure[segments[index]] : undefined;
+    }
+    if (!host) return;
+    if (!plan) {
+      const expression = getGateExpression(this.blueprint, occurrence.gate.schemaPath);
+      const name = expression && readPureGateKey(occurrence.gate, expression, host.blueprintNode);
+      if (name === undefined || !expression) {
+        this.plans!.set(occurrence, null);
+        return;
+      }
+      plan = { template: host.blueprintNode, expression, segments, name,
+        path: `${occurrence.hostPath}/${expression.dependencies[0].slice(2)}` };
+      this.plans!.set(occurrence, plan);
+    }
+    const work = this.work(context);
+    const pass = work.passes.get(host);
+    if (!pass?.safe || pass.version !== work.version || host.raw !== undefined ||
+      plan.template !== host.blueprintNode || host.detached) return;
+    const child = host.structure && hasOwnProperty(host.structure, plan.name)
+      ? host.structure[plan.name] : undefined;
+    if (!child || child.detached || child.parent !== host ||
+      child.behavior.strategy !== 'terminal') return;
+    const flushed = flushPendingOutput(child, context);
+    const hostUncomputed = context.changedRaw.has(host.path) && !context.changedNodes.has(host);
+    const childUncomputed = context.changedRaw.has(child.path) && !context.changedNodes.has(child);
+    const extrasExposed = pass.safe && host.raw === undefined;
+    let slot = work.slots.get(occurrence);
+    const local = slot !== undefined;
+    if (!slot && context.kind !== 'load' && context.pathChanges.length === 0 &&
+      !pass.touched && !context.changedRaw.has(child.path) &&
+      !context.entered.has(host) && !context.entered.has(child))
+      slot = this.committed!.get(occurrence);
+    let result: boolean;
+    if (!flushed && slot && (!local || slot.version === work.version) &&
+      slot.host === host && slot.hostExtras === host.extras &&
+      slot.hostUncomputed === hostUncomputed && slot.extrasExposed === extrasExposed &&
+      slot.child === child && slot.childEmit === child.emit &&
+      slot.childSchema === child.schema && slot.childUncomputed === childUncomputed) {
+      result = slot.result;
+      if (!local) work.slots.set(occurrence, { ...slot, version: work.version });
+    } else {
+      const version = context.gateThrowVersion ?? 0;
+      result = evaluatePureGate(plan.expression, readProjectedValue(context, plan.path));
+      if ((context.gateThrowVersion ?? 0) !== version) return result;
+      work.slots.set(occurrence, { host, hostExtras: host.extras, hostUncomputed,
+        extrasExposed, child, childEmit: child.emit, childSchema: child.schema,
+        childUncomputed, result, version: work.version });
+    }
+    if (process.env.NODE_ENV === 'test') {
+      const fresh = Boolean(plan.expression.evaluate([readGateResultShadow(context, plan.path)]));
+      if (result !== fresh) throw new Error(`Gate result shadow mismatch at ${occurrence.gate.schemaPath}`);
+    }
+    return result;
+  }
+
+  /**
+   * Publish only successful slots with no contact after their last evaluation.
+   * @param context - Completed call after ordinary commit publication
+   * @returns Nothing; failures discard committed proof and call-local containers
+   */
+  commit<Self extends SchemaNodeRecord<Self>>(context: SettlementContext<Self>): void {
+    const work = this.works?.get(context);
+    if (!work) return;
+    if (context.failures?.length || context.gateThrowVersion || context.exceededBudget ||
+      context.root.runtime.diagnostics.status === 'degraded') {
+      this.committed = new WeakMap();
+      this.works!.delete(context);
+      return;
+    }
+    for (const [occurrence, slot] of work.slots) {
+      const plan = this.plans!.get(occurrence);
+      if (!plan || slot.version !== work.version) continue;
+      let host: Self | undefined = context.root;
+      for (let index = 0; index < plan.segments.length; index++) {
+        const structure: Record<string, Self> | null | undefined = host?.structure;
+        host = structure && hasOwnProperty(structure, plan.segments[index])
+          ? structure[plan.segments[index]] : undefined;
+      }
+      const child = host?.structure && hasOwnProperty(host.structure, plan.name)
+        ? host.structure[plan.name] : undefined;
+      if (host && child && host === slot.host && child === slot.child &&
+        !host.detached && !child.detached && host.raw === undefined &&
+        host.extras === slot.hostExtras && child.emit === slot.childEmit &&
+        child.schema === slot.childSchema && !context.pendingOutputs?.has(child) &&
+        (context.changedRaw.has(host.path) && !context.changedNodes.has(host)) === slot.hostUncomputed &&
+        (context.changedRaw.has(child.path) && !context.changedNodes.has(child)) === slot.childUncomputed)
+        this.committed!.set(occurrence, slot);
+      else this.committed!.delete(occurrence);
+    }
+    this.works!.delete(context);
+  }
+
+  /**
+   * Allocate one stable work shape lazily, leaving branchless contexts unchanged.
+   * @param context - Settlement identity weakly retained during evaluation
+   * @returns Stable provisional slot and pass-proof containers
+   */
+  private work(context: object): GateResultWork {
+    let work = this.works!.get(context);
+    if (!work) {
+      work = { slots: new Map(), passes: new WeakMap(), version: 0 };
+      this.works!.set(context, work);
+    }
+    return work;
+  }
+}
+
+/** Registry and result memo share the runtime's lifetime without retaining roots globally. */
+const MEMOS = new WeakMap<object, GateResultMemo>();
+
+/** Syntax absence needs no runtime, blueprint, pass proof or mutable container. */
+const EMPTY_MEMO = new GateResultMemo();
+
+/**
+ * Get the occurrence result store for a gate-bearing runtime.
+ * @param runtime - Shared runtime identity and immutable analyzed blueprint
+ * @returns Stable result store, or the shared empty memo after syntax-absence proof
+ */
+export const getGateResultMemo = (runtime: { blueprint: Blueprint }): GateResultMemo => {
+  let memo = MEMOS.get(runtime);
+  if (!memo) {
+    memo = hasPureGateCandidates(runtime.blueprint)
+      ? new GateResultMemo(runtime.blueprint) : EMPTY_MEMO;
+    MEMOS.set(runtime, memo);
+  }
+  return memo;
+};
