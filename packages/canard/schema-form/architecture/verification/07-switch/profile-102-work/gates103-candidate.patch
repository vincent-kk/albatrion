+import { unescapeSegment } from '@winglet/json/pointer';
+
+import type { BlueprintExpression, BlueprintGate, BlueprintNode } from '../../../../../blueprint';
+
+import { hasPureGateCondition } from './hasPureGateCondition';
+
+/**
+ * Prove a complete pure read of a unique, unconditionally declared direct key.
+ * @param gate - Authored active condition, never executed by this proof
+ * @param expression - Original compiler descriptor with its entire dependency list
+ * @param template - Current host template, including all alternative entry kinds
+ * @returns Decoded key, or undefined for callbacks, ambiguity and dynamic reads
+ */
+export const readPureGateKey = (
+  gate: BlueprintGate, expression: BlueprintExpression, template: BlueprintNode,
+): string | undefined => {
+  if (!hasPureGateCondition(gate) || expression.dependencies.length !== 1 ||
+    template.kind !== 'object') return;
+  const dependency = expression.dependencies[0];
+  if (!dependency.startsWith('./') || dependency.slice(2).includes('/') ||
+    dependency.includes('*')) return;
+  const name = unescapeSegment(dependency.slice(2));
+  let matches = 0;
+  let unconditional = false;
+  const entries = template.childEntries;
+  for (let index = 0; index < entries.length; index++) {
+    const entry = entries[index];
+    if (entry.name !== name) continue;
+    if (++matches > 1) return;
+    for (let declaration = 0; declaration < entry.declarations.length; declaration++)
+      if (entry.declarations[declaration].gates.length === 0) unconditional = true;
+  }
+  return matches === 1 && unconditional ? name : undefined;
+};
