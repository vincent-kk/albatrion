+import { describe, expect, it, vi } from 'vitest';
+
+import * as results from '../utils/gates/getGateResultMemo';
+import { gateSelectionCases } from './fixtures/gateSelectionCases';
+import { installGateSelectionShadow } from './helpers/installGateSelectionShadow';
+import { runGateSelectionCase } from './helpers/runGateSelectionCase';
+
+// filid:contract settle-gate-result-reuse
+describe('pure gate results against full evaluation at original sites', () => {
+  it.each(gateSelectionCases)('$name', fixture => {
+    const original = results.getGateResultMemo;
+    const disabled = new WeakSet<object>();
+    vi.spyOn(results, 'getGateResultMemo').mockImplementation(runtime => {
+      const memo = original(runtime);
+      if (!disabled.has(memo)) {
+        disabled.add(memo);
+        vi.spyOn(memo, 'evaluate').mockReturnValue(undefined);
+      }
+      return memo;
+    });
+    let expected: ReturnType<typeof runGateSelectionCase>;
+    try { expected = runGateSelectionCase(fixture); }
+    finally { vi.restoreAllMocks(); }
+    const shadow = installGateSelectionShadow();
+    try {
+      expect(runGateSelectionCase(fixture)).toEqual(expected);
+      expect(shadow.violations).toEqual([]);
+      expect(shadow.count).toBeGreaterThan(0);
+    } finally { shadow.restore(); }
+  });
+});
