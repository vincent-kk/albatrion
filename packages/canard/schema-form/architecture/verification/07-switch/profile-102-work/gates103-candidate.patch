@@ -0,0 +1,13 @@
+import type { BlueprintGate } from '../../../../../blueprint';
+
+/** Complete direct-path strict comparisons cannot invoke callbacks or coercions. */
+const PURE_COMPARISON = /^\s*\.\/[^\s()=!<>;&|]+\s*(?:===|!==)\s*(?:"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?|true|false|null|undefined)\s*;?\s*$/;
+
+/**
+ * Recognize a necessary pure syntax condition without executing authored code.
+ * @param gate - Immutable gate whose complete condition is inspected
+ * @returns Whether dependency and live-host proof may qualify this condition
+ */
+export const hasPureGateCondition = (gate: BlueprintGate): boolean =>
+  gate.kind === 'active' && typeof gate.condition === 'string' &&
+  PURE_COMPARISON.test(gate.condition);
