+import type { BlueprintExpression, BlueprintNode } from '../../../../blueprint';
+import type { GateOccurrence } from '../type';
+
+/** Proven single-key expression and occurrence-relative host address. */
+export interface GateResultPlan {
+  /** Current template whose unique ungated key proved eligibility. */
+  template: BlueprintNode;
+  /** Compiled function retained without recompilation or substitution. */
+  expression: BlueprintExpression;
+  /** Decoded host segments; current structure is followed at every site. */
+  segments: readonly string[];
+  /** Unique direct key consumed by the expression. */
+  name: string;
+  /** Bound baseline-reader address. */
+  path: string;
+}
+
+/** Stable-shape successful result, independent of a settlement's work containers. */
+export interface GateResultSlot {
+  /** Identity and projection fields compared at every original site. */
+  host: object;
+  hostExtras: unknown;
+  hostUncomputed: boolean;
+  extrasExposed: boolean;
+  child: object;
+  childEmit: unknown;
+  childSchema: object;
+  childUncomputed: boolean;
+  /** Successful false remains distinct from an absent or thrown result. */
+  result: boolean;
+  /** Last evaluation's recalculation-registration boundary. */
+  version: number;
+}
+
+/** Call-local provisional slots and pass-entry ancestor evidence. */
+export interface GateResultWork {
+  /** Provisional results never become committed during evaluation. */
+  slots: Map<GateOccurrence, GateResultSlot>;
+  /** Safe host ancestors at a particular recalculation boundary. */
+  passes: WeakMap<object, { safe: boolean; touched: boolean; version: number }>;
+  /** Supplemental invalidation; never replaces current-read comparisons. */
+  version: number;
+}
