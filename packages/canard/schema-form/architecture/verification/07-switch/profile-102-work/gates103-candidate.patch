@@ -0,0 +1,48 @@
+import type { Blueprint, BlueprintGate, PropertyDeclaration } from '../../../../../blueprint';
+
+import { hasPureGateCondition } from './hasPureGateCondition';
+
+/**
+ * Inspect a gate and its short-circuit parents without evaluating expressions.
+ * @param gate - Existing own or edge gate with its immutable parent chain
+ * @returns Whether any original evaluation site may contain pure syntax
+ */
+const chainHasCandidate = (gate: BlueprintGate): boolean => {
+  if (hasPureGateCondition(gate)) return true;
+  const parents = gate.appliesWhen;
+  for (let index = 0; index < (parents?.length ?? 0); index++)
+    if (chainHasCandidate(parents![index])) return true;
+  return false;
+};
+
+/**
+ * Inspect existing declaration references without allocating a gate index.
+ * @param declarations - Existing ordered own or edge contributions
+ * @returns Whether one referenced gate has a necessary pure syntax condition
+ */
+const declarationsHaveCandidate = (declarations: readonly PropertyDeclaration[]): boolean => {
+  for (let index = 0; index < declarations.length; index++) {
+    const gates = declarations[index].gates;
+    for (let gate = 0; gate < gates.length; gate++)
+      if (chainHasCandidate(gates[gate])) return true;
+  }
+  return false;
+};
+
+/**
+ * Prove syntax absence across all finite templates without choosing a compiled expression.
+ * @param blueprint - Immutable own/edge declarations, including recursive templates
+ * @returns False only when no gate can satisfy the original-site pure proof
+ */
+export const hasPureGateCandidates = (blueprint: Blueprint): boolean => {
+  if (blueprint.capabilities.branchless) return false;
+  const nodes = blueprint.nodes;
+  for (let index = 0; index < nodes.length; index++) {
+    const node = nodes[index];
+    if (declarationsHaveCandidate(node.declarations)) return true;
+    const entries = node.childEntries;
+    for (let entry = 0; entry < entries.length; entry++)
+      if (declarationsHaveCandidate(entries[entry].declarations)) return true;
+  }
+  return false;
+};
diff --git a/packages/canard/schema-form/src/core/settle/__tests__/settle.gate-result-reuse.test.ts b/packages/canard/schema-form/src/core/settle/__tests__/settle.gate-result-reuse.test.ts
