+import type { BlueprintExpression } from '../../../../../blueprint';
+
+/**
+ * Execute the original compiled function only after a proven read changes.
+ * @param expression - Pure, complete, single-key compiler descriptor
+ * @param value - Baseline projected value at the original evaluation site
+ * @returns Successful boolean result; exceptions remain the caller's gate failure
+ */
+export const evaluatePureGate = (
+  expression: BlueprintExpression, value: unknown,
+): boolean => Boolean(expression.evaluate([value]));
diff --git a/packages/canard/schema-form/src/core/settle/utils/gates/getGateResultMemo/utils/readGateResultShadow.ts b/packages/canard/schema-form/src/core/settle/utils/gates/getGateResultMemo/utils/readGateResultShadow.ts
