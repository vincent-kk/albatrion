diff --git a/packages/canard/schema-form/src/core/record/utils/__tests__/SchemaNodeRevisionLedger.first-value-counts.test.ts b/packages/canard/schema-form/src/core/record/utils/__tests__/SchemaNodeRevisionLedger.first-value-counts.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/canard/schema-form/src/core/record/utils/__tests__/SchemaNodeRevisionLedger.first-value-counts.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { SchemaNodeEventType } from '../../SchemaNodeEventType';
+import { EMPTY_REVISION_LEDGER } from '../../type';
+import { SchemaNodeRevisionLedger } from '../SchemaNodeRevisionLedger';
+
+/** This exact first delivery owns the value and refresh counters only. */
+const FIRST_VALUE_MASK = SchemaNodeEventType.UpdateValue | SchemaNodeEventType.RequestRefresh;
+
+describe('first value delivery counter work', () => {
+  it('initializes private counters without per-bit index calculations', () => {
+    const index = vi.spyOn(Math, 'clz32');
+    const ledgers: SchemaNodeRevisionLedger[] = [];
+    let calculations: number;
+    try {
+      for (let node = 0; node < 8; node++)
+        ledgers.push(new SchemaNodeRevisionLedger(EMPTY_REVISION_LEDGER, FIRST_VALUE_MASK));
+      calculations = index.mock.calls.length;
+    } finally { index.mockRestore(); }
+    for (let node = 0; node < ledgers.length; node++) {
+      const ledger = ledgers[node];
+      expect(ledger.read(-1)).toBe(2);
+      for (let bitIndex = 0; bitIndex < 17; bitIndex++)
+        expect(ledger[1 << bitIndex]).toBe(bitIndex === 2 || bitIndex === 13 ? 1 : undefined);
+      for (let prior = 0; prior < node; prior++) expect(ledger).not.toBe(ledgers[prior]);
+    }
+    const previous = ledgers[0];
+    const laterIndex = vi.spyOn(Math, 'clz32');
+    let next: SchemaNodeRevisionLedger;
+    try {
+      next = new SchemaNodeRevisionLedger(previous, FIRST_VALUE_MASK);
+      expect(laterIndex.mock.calls.length).toBe(2);
+    } finally { laterIndex.mockRestore(); }
+    expect(next![SchemaNodeEventType.UpdateValue]).toBe(2);
+    expect(next![SchemaNodeEventType.RequestRefresh]).toBe(2);
+    expect(previous[SchemaNodeEventType.UpdateValue]).toBe(1);
+    console.log(`106COUNT first-value bit-index=${calculations!} ledgers=${ledgers.length}`);
+    expect(calculations!).toBe(0);
+  });
+});
