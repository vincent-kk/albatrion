diff --git a/packages/canard/schema-form/src/core/settle/__tests__/settle.single-selection-counts.test.ts b/packages/canard/schema-form/src/core/settle/__tests__/settle.single-selection-counts.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/canard/schema-form/src/core/settle/__tests__/settle.single-selection-counts.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it, vi } from 'vitest';
+import { isArray } from '@winglet/common-utils/filter';
+
+import { SetValueOption } from '../../types/value';
+import { loadSchemaNodeAtMount, writeSchemaNode } from '../index';
+import { createTestTree } from './fixtures/createTestTree';
+
+describe('single declaration selection work', () => {
+  it('publishes one immutable ID list across successful gated selections', () => {
+    const { root } = createTestTree({
+      type: 'object', properties: { kind: { type: 'string' } },
+      anyOf: [{ controls: { active: '@.gate()' },
+        properties: { payload: { type: 'string', default: 'P' } } }],
+    });
+    const entry = root.blueprintNode.childEntries.find(edge => edge.name === 'payload')!;
+    expect(entry.declarations).toHaveLength(1);
+    const gate = vi.fn(() => true);
+    root.runtime.context = { gate };
+    const selected = vi.spyOn(Map.prototype, 'set');
+    const lists: (readonly number[])[] = [];
+    const unique: unknown[] = [];
+    try {
+      loadSchemaNodeAtMount(root, { kind: 'a' }, SetValueOption.Overwrite);
+      for (let index = 0; index < 3; index++)
+        writeSchemaNode(root.structure!.kind, `kind_${index}`, 'input', SetValueOption.Overwrite);
+      expect(root.emit).toEqual({ kind: 'kind_2', payload: 'P' });
+      for (let index = 0; index < selected.mock.calls.length; index++) {
+        const [key, value] = selected.mock.calls[index];
+        if (key !== null && typeof key === 'object' &&
+          'blueprintNode' in key && key.blueprintNode === entry.node &&
+          isArray(value) && value.length === 1 && value[0] === entry.declarations[0].id) {
+          lists.push(value);
+          if (!unique.includes(value)) unique.push(value);
+        }
+      }
+    } finally { selected.mockRestore(); }
+    expect(lists.length).toBeGreaterThan(0);
+    for (let index = 0; index < lists.length; index++)
+      expect(lists[index]).toEqual([entry.declarations[0].id]);
+    expect(gate.mock.calls.length).toBeGreaterThan(1);
+    console.log(`106COUNT single-selection lists=${unique.length} publications=${lists.length} evaluate=${gate.mock.calls.length}`);
+    expect(unique).toHaveLength(1);
+    expect(Object.isFrozen(unique[0])).toBe(true);
+  });
+});
