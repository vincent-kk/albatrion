diff --git a/packages/canard/schema-form/src/core/blueprint/__tests__/blueprint.owned-inline-declaration-copies.test.ts b/packages/canard/schema-form/src/core/blueprint/__tests__/blueprint.owned-inline-declaration-copies.test.ts
