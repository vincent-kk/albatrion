diff --git a/packages/canard/schema-form/src/core/behaviors/objectBehavior/branch/utils/__tests__/assembleObject.first-work.test.ts b/packages/canard/schema-form/src/core/behaviors/objectBehavior/branch/utils/__tests__/assembleObject.first-work.test.ts
