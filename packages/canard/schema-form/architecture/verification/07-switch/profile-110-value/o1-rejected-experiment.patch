diff --git a/packages/canard/schema-form/src/core/settle/utils/compute/__tests__/updateOutput.hint.test.ts b/packages/canard/schema-form/src/core/settle/utils/compute/__tests__/updateOutput.hint.test.ts
new file mode 100644
index 000000000..a854d0c05
--- /dev/null
+++ b/packages/canard/schema-form/src/core/settle/utils/compute/__tests__/updateOutput.hint.test.ts
@@ -0,0 +1,134 @@
+import { afterEach, expect, it, vi } from 'vitest';
+
+import { BEHAVIORS } from '../../../../behaviors';
+import { dispatchMount, dispatchSetValue, subscribeSchemaNode } from '../../../../dispatch';
+import { SetValueOption } from '../../../../types/value';
+import { createTestTree } from '../../../__tests__/fixtures/createTestTree';
+import type { PlainNode } from '../../../__tests__/fixtures/createPlainNode';
+import type { SettlementContext } from '../../../type';
+import { updateOutput } from '../updateOutput';
+
+afterEach(() => vi.restoreAllMocks());
+
+/** Minimal output-only context; these probes never enter marking or commit. */
+const contextFor = (root: PlainNode): SettlementContext<PlainNode> => ({
+  root, changedNodes: new Set<PlainNode>(),
+} as SettlementContext<PlainNode>);
+
+/** Follow value edges, including symbol keys, without visiting an object twice. */
+const containsHint = (value: unknown, hints: readonly object[]): boolean => {
+  const pending: unknown[] = [value];
+  const seen = new Set<object>();
+  while (pending.length) {
+    const current = pending.pop();
+    if (current === null || typeof current !== 'object') continue;
+    if (hints.includes(current)) return true;
+    if (seen.has(current)) continue;
+    seen.add(current);
+    for (const key of Reflect.ownKeys(current)) pending.push(Reflect.get(current, key));
+  }
+  return false;
+};
+
+it('reuses one hint across assemblies in one call and isolates other calls', () => {
+  const { root } = createTestTree({ type: 'object' });
+  const hints: object[] = [];
+  vi.spyOn(root.behavior, 'assemble').mockImplementation((_node, _children, _changed, hint) => {
+    expect(hint).toBeDefined();
+    hints.push(hint!);
+    return {};
+  });
+  const first = contextFor(root);
+  const second = contextFor(root);
+  updateOutput(root, first, []);
+  updateOutput(root, first, []);
+  updateOutput(root, second, []);
+  updateOutput(root, second, []);
+  expect(hints[1]).toBe(hints[0]);
+  expect(hints[2]).not.toBe(hints[0]);
+  expect(hints[3]).toBe(hints[2]);
+});
+
+it('resets every hint field before eligible and ineligible assemblies', () => {
+  const { root } = createTestTree({ type: 'object' });
+  let retained: { incremental: boolean } | undefined;
+  vi.spyOn(root.behavior, 'assemble').mockImplementation((_node, _children, _changed, hint) => {
+    if (retained) expect(retained).toEqual({ incremental: false });
+    if (hint) {
+      expect(Reflect.ownKeys(hint)).toEqual(['incremental']);
+      expect(hint).toEqual({ incremental: false });
+      retained = hint;
+      hint.incremental = true;
+    }
+    return {};
+  });
+  const context = contextFor(root);
+  updateOutput(root, context, []);
+  updateOutput(root, context, []);
+  updateOutput(root, context);
+  updateOutput(root, context, []);
+});
+
+it('resets the retained hint before virtual-node re-entry', () => {
+  const { root } = createTestTree({ type: 'object', properties: {
+    group: { type: 'object' },
+  }, options: { virtual: { combined: { fields: ['group'] } } } });
+  dispatchMount(root, undefined, SetValueOption.Overwrite);
+  const group = root.structure!.group;
+  const virtual = root.structure!.combined;
+  expect(virtual.behavior.type).toBe('virtual');
+  let retained: { incremental: boolean } | undefined;
+  vi.spyOn(group.behavior, 'assemble').mockImplementation((_node, _children, _changed, hint) => {
+    expect(hint).toBeDefined();
+    retained = hint;
+    hint!.incremental = true;
+    return { changed: true };
+  });
+  const virtualAssembly = vi.spyOn(virtual.behavior, 'assemble').mockImplementation(() => {
+    expect(retained).toEqual({ incremental: false });
+    return { changed: true };
+  });
+  const context = contextFor(root);
+  context.virtualReferenceIndex = new Map([[root.blueprintNode, new Map([['group', ['combined']]])]]);
+  group.local = undefined;
+  updateOutput(group, context, []);
+  expect(virtualAssembly).toHaveBeenCalledTimes(1);
+});
+
+it('never exposes any hint through emitted values or delivered payloads', () => {
+  const { root } = createTestTree({ type: 'object', properties: {
+    nested: { type: 'object', properties: { value: { type: 'number', default: 1 } } },
+    tail: { type: 'number', default: 2 },
+  }, options: { virtual: { combined: { fields: ['nested', 'tail'] } } } });
+  const hints: object[] = [];
+  const payloads: unknown[] = [];
+  const attach = (node: PlainNode) => {
+    const row = BEHAVIORS[node.behavior.type][node.behavior.strategy];
+    vi.spyOn(node.behavior, 'assemble').mockImplementation((current, children, changed, hint) => {
+      if (hint && !hints.includes(hint)) hints.push(hint);
+      return Reflect.apply(row.assemble, undefined, [current, children, changed, hint]);
+    });
+    subscribeSchemaNode(node, event => payloads.push(event));
+  };
+  attach(root);
+  const factory = root.runtime.nodeFactory;
+  root.runtime.nodeFactory = (entry, parent, runtime) => {
+    const node = factory(entry, parent, runtime);
+    attach(node);
+    return node;
+  };
+  dispatchMount(root, undefined, SetValueOption.Overwrite);
+  for (const value of [3, 4, 1, 1])
+    dispatchSetValue(root.structure!.nested.structure!.value, value, SetValueOption.Overwrite);
+  expect(hints.length).toBeGreaterThan(0);
+  expect(payloads.length).toBeGreaterThan(0);
+  const pending = [root];
+  while (pending.length) {
+    const node = pending.pop()!;
+    expect(containsHint(node.emit, hints), node.path).toBe(false);
+    expect(containsHint(node.local, hints), node.path).toBe(false);
+    expect(containsHint(node.pendingDelivery?.payload, hints), node.path).toBe(false);
+    for (const child of node.children ?? []) if (child.parent === node) pending.push(child);
+  }
+  expect(containsHint(payloads, hints)).toBe(false);
+});

