{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "./dist",
    "paths": {
      "@/schema-form": ["../../canard/schema-form/src"],
      "@/schema-form/*": ["../../canard/schema-form/src/*"],
      "@/common-utils": ["../../winglet/common-utils/src"],
      "@/common-utils/*": ["../../winglet/common-utils/src/*"],
      "@aileron/*": ["../../aileron/common/*"]
    }
  },
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../canard/schema-form/src/**/*.ts",
    "../../winglet/common-utils/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "scripts",
    "__test__",
    "__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.tsx"
  ]
}
