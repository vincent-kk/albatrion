{
  "name": "@lerx/promise-modal",
  "version": "0.14.0",
  "description": "Universal React modal utility that can be used outside React components with promise-based results for alert, confirm, and prompt modals",
  "keywords": [
    "react",
    "modal",
    "promise",
    "alert",
    "confirm",
    "prompt",
    "typescript",
    "utility",
    "ui-components",
    "dialog",
    "popup",
    "toast",
    "notification",
    "modal-utility",
    "imperative-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vincent-kk/albatrion.git",
    "directory": "packages/lerx/promise-modal"
  },
  "license": "MIT",
  "author": {
    "name": "Vincent K. Kelvin",
    "email": "lunox273@gmail.com"
  },
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "**/style.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "rolldown -c && yarn build:types && yarn build:hashes && yarn typecheck",
    "build:hashes": "agents-build-hashes",
    "build:publish:npm": "yarn build && yarn publish:npm",
    "build:types": "node ../../aileron/script/build/buildTypes.mjs",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "make-dependency-graph": "npx depcruise src --config .dependency-cruiser.js --output-type dot > dependency-graph.dot && dot -Tpng dependency-graph.dot -o dependency-graph.png",
    "prepublishOnly": "yarn build",
    "publish:npm": "yarn npm publish --access public",
    "size-limit": "size-limit",
    "start": "yarn build && yarn storybook",
    "storybook": "storybook dev -p 6006",
    "test": "yarn run -T vitest",
    "test:prod": "yarn run -T vitest run --config vitest.prod.config.ts",
    "typecheck": "tsc --noEmit --composite false --rootDir . -p tsconfig.json",
    "version:major": "yarn version major",
    "version:minor": "yarn version minor",
    "version:patch": "yarn version patch"
  },
  "dependencies": {
    "@winglet/common-utils": "workspace:^",
    "@winglet/react-utils": "workspace:^",
    "@winglet/style-utils": "workspace:^"
  },
  "devDependencies": {
    "@slats/agents-assets-sync": "workspace:^",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "antd": "^5.22.5",
    "eslint": "8.57.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rolldown": "^1.2.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "agents": {
    "assetPath": "docs/agents"
  }
}
